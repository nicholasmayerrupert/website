      "cName": "Biome",
      "cType": "int",
      "jsName": "BIOME",
      "jsPrefix": "BIOME",
      "values": {
        "BIOME_PLAINS": 0,
        "BIOME_FOREST": 1,
        "BIOME_DESERT": 2,
