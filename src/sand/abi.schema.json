{
  "$comment": "Single source of truth for the JS<->WASM ABI: packed-snapshot field layouts, shared enums, and the version stamp. `npm run generate:abi` emits cpp/engine/abi.generated.hpp and wasmBridge/abi.generated.js; the wasm build fails if they are stale. Bump abiVersion on ANY layout/enum change — initSandWasm() refuses a module whose engine_abi_version() mismatches, which catches stale committed sandEngine artifacts immediately.",
  "abiVersion": 27,
  "structs": {
    "playerSnapshot": {
      "$comment": "float32 records built by buildPlayerSnapshot (player.inc); read by engineFactory.getPlayers/getPlayer and the net layer.",
      "cPrefix": "PS",
      "fields": ["id", "active", "x", "y", "vx", "vy", "w", "h", "facing", "grounded", "tool", "aimX", "aimY", "health", "inputSeq", "alive", "jumpReady", "animState", "animFrame", "deathTicks", "respawnReady", "bowCharge", "heldItemKind", "jetpackFuel", "jetpackActive", "shieldHealth", "shieldActive"]
    },
    "itemSnapshot": {
      "$comment": "float32 records built by buildItemSnapshot (items.inc); also the external GL item layout (glSetItems) and the ITEMS wire message payload.",
      "cPrefix": "IS",
      "fields": ["id", "kind", "material", "count", "x", "y", "life", "plantType", "itemKind", "isTool", "toolClass", "toolTier"]
    },
    "creatureSnapshot": {
      "$comment": "float32 creature records built by CreatureSystem; also used by the external GL renderer and CREATURES wire message.",
      "cPrefix": "CSN",
      "fields": ["id", "species", "x", "y", "vx", "vy", "w", "h", "facing", "health", "maxHealth", "alive", "animFrame", "attackState", "attackProgress", "aimX", "aimY", "spawnProgress", "attackPattern"]
    },
    "inventorySlot": {
      "$comment": "float32 records built by buildInventorySnapshot / buildCursorSnapshot (inventory.inc). The cursor snapshot uses the same layout with `selected` unused.",
      "cPrefix": "IVS",
      "fields": ["material", "isTool", "toolClass", "toolTier", "count", "plantType", "itemKind", "selected"]
    },
    "projectileSnapshot": {
      "$comment": "float32 projectile records used by the authority, network, and external GL renderer.",
      "cPrefix": "PRS",
      "fields": ["id", "owner", "x", "y", "vx", "vy", "charge", "kind", "fuse", "rotation"]
    },
    "craftingRecipe": {
      "$comment": "int32 recipe headers; ingredientStart/count index craftingIngredient records.",
      "cPrefix": "CR",
      "fields": ["id", "outputKind", "outputMaterial", "outputTier", "outputCount", "ingredientStart", "ingredientCount"]
    },
    "craftingIngredient": {
      "$comment": "int32 recipe ingredients: kind selects exact material or material flag.",
      "cPrefix": "CI",
      "fields": ["kind", "value", "count"]
    },
    "survivalFootprint": {
      "$comment": "int32 records built by buildSurvivalFootprintSnapshot (inventory.inc).",
      "cPrefix": "FP",
      "fields": ["id", "width", "height", "cellCount", "anchorX", "anchorY"]
    },
    "glPlayerExt": {
      "$comment": "float32 records a multiplayer client packs for engine_gl_set_players (host-authoritative snapshot players).",
      "cPrefix": "GLP",
      "fields": ["x", "y", "w", "h", "facing", "own", "animState", "animFrame", "alive", "heldItemKind", "bowCharge", "aimX", "aimY", "jetpackFuel", "jetpackActive", "shieldHealth", "shieldActive"]
    },
    "soundEvent": {
      "$comment": "float32 semantic audio events drained from the authoritative engine. Coordinates are absolute world cells so streaming cannot move a queued sound.",
      "cPrefix": "SND",
      "fields": ["type", "x", "y", "intensity", "material", "layer"]
    },
    "perfSnapshot": {
      "$comment": "double records written by engine_perf_snapshot. Fine step phases accumulate across both layers; counts are totals for the last step. Bump abiVersion on layout change.",
      "cPrefix": "PF",
      "fields": [
        "stepMs", "actorMs",
        "dirtyChunks", "dirtyRows", "dirtyCells",
        "componentCount", "componentCellCount", "crossBondCount",
        "lightMs", "fillMs", "uploadMs",
        "shiftBuffers", "shiftTranslate", "shiftRegister", "shiftFill",
        "groundingMs", "crossLayerGroundingMs", "componentIndexMs", "assemblyUnionMs",
        "carryMs", "bodyMs", "sandMs", "liquidMs", "gasMs",
        "reactMs", "tailMs", "layersMs", "crossMs"
      ]
    },
    "missionSnapshot": {
      "$comment": "int32 mission header built by MissionSystem. Objective coordinates are absolute world cells and remain stable across streaming.",
      "cPrefix": "MS",
      "fields": ["revision", "missionId", "planetId", "phase", "objectiveCount", "threatLevel", "extractionX", "extractionY", "elapsedTicks", "recoveredWeaponMask"]
    },
    "objectiveSnapshot": {
      "$comment": "int32 authoritative objective records built by MissionSystem.",
      "cPrefix": "OS",
      "fields": ["id", "type", "state", "current", "required", "worldX", "worldY", "targetActorId", "flags"]
    },
    "worldContext": {
      "$comment": "int32 semantic description of one absolute world coordinate. Feature bounds are inclusive and feature ids are stable for a worldgen version.",
      "cPrefix": "WC",
      "fields": ["surfaceBiome", "caveBiome", "surfaceY", "depth", "tags", "featureKind", "siteRole", "featureId", "parentFeatureId", "left", "top", "right", "bottom"]
    }
  },
  "enums": {
    "PlayerInput": {
      "$comment": "Input bitmask (player.inc / the browser input layer / the net protocol).",
      "cName": "PlayerInput",
      "jsName": "INPUT",
      "jsPrefix": "PI",
      "values": { "PI_LEFT": 1, "PI_RIGHT": 2, "PI_JUMP": 4, "PI_DOWN": 8, "PI_PRIMARY": 16, "PI_SECONDARY": 32, "PI_RUN": 64, "PI_JETPACK": 128, "PI_SHIELD": 256 }
    },
    "InventoryItemKind": {
