      "cName": "ProjectileKind",
      "cType": "uint8_t",
      "jsName": "PROJECTILE_KIND",
      "jsPrefix": "PK",
      "values": {
        "PK_ARROW": 0,
        "PK_BLAST_ROUND": 1,
        "PK_DYNAMITE": 2,
        "PK_ACID_SHELL": 3,
