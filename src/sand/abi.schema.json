      "$comment": "Creature species ids used by snapshots, test hooks, and the network renderer.",
      "cName": "CreatureSpeciesAbi",
      "cType": "int",
      "jsName": "CREATURE",
      "jsPrefix": "CREATURE",
      "values": {
        "CREATURE_MINNOW": 0,
        "CREATURE_PIKE": 1,
        "CREATURE_FOX": 2,
        "CREATURE_HARE": 3,
        "CREATURE_CRAWLER": 4,
        "CREATURE_MOLE": 5,
        "CREATURE_BIRD": 6,
        "CREATURE_DYNAMITEER": 7,
        "CREATURE_BORE_SENTINEL": 8,
        "CREATURE_CAUSTIC_MORTARMAN": 9,
        "CREATURE_CLUSTER_WASP": 10,
        "CREATURE_MINIGUNNER": 11,
        "CREATURE_SURVEYOR": 12,
        "CREATURE_SHIELD_ANCHOR": 13,
        "CREATURE_QUARRY_FOREMAN": 14,
        "CREATURE_REACTOR_WARDEN": 15,
        "CREATURE_REACTOR_CORE": 16,
        "CREATURE_IRIS_COMMANDER": 17,
        "CREATURE_IRIS_ENGINEER": 18,
        "CREATURE_VILLAGER": 19
      }
    },
    "CreatureAttackState": {
      "$comment": "Replicated enemy telegraph/fire state used by simulation, transport, and GL presentation.",
      "cName": "CreatureAttackState",
      "cType": "uint8_t",
      "jsName": "CREATURE_ATTACK_STATE",
      "jsPrefix": "CAS",
      "values": { "CAS_IDLE": 0, "CAS_CHARGING": 1, "CAS_FIRING": 2 }
    },
    "PlanetId": {
      "$comment": "Planet policy shared by campaign metadata and the C++ simulation.",
      "cName": "PlanetId",
      "cType": "uint8_t",
      "jsName": "PLANET",
      "jsPrefix": "PL",
      "values": { "PL_EARTH": 0, "PL_MOON": 1, "PL_MARS": 2, "PL_SHIP": 3 }
    },
    "SurfaceBiome": {
