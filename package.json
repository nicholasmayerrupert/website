{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/generate-materials.mjs",
    "generate:check": "node scripts/generate-materials.mjs --check",
    "build": "node scripts/generate-materials.mjs --check && vite build",
    "build:embed": "vite build --config vite.config.embed.js",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test:sand": "node scripts/sand-test.mjs",
    "test:players": "node scripts/player-test.mjs",
    "test:net": "node scripts/net-test.mjs",
    "test:layer": "node scripts/layer-test.mjs",
    "test:e2e": "node scripts/player-e2e.mjs",
    "test": "npm run test:sand && npm run test:players && npm run test:net && npm run test:layer",
    "test:all": "npm run test && npm run build",
    "mp:server": "node scripts/dev-multiplayer-server.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@lottiefiles/react-lottie-player": "^3.5.3",
    "@types/three": "^0.163.0",
    "docs": "^0.3.2-canary.0",
    "gsap": "^3.13.0",
    "lottie-react": "^2.4.0",
    "react": "^18.2.0",
    "react-card-flip": "^1.2.3",
    "react-dom": "^18.2.0",
    "react-icons": "^5.1.0",
    "react-lottie": "^1.2.4",
    "three": "^0.163.0",
    "wrangler": "^4.55.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "playwright": "^1.61.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tailwindcss-textshadow": "^2.1.3",
    "vite": "^5.4.21"
  }
}
