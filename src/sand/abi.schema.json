      "jsPrefix": "IK",
      "values": {
        "IK_MATERIAL": 0,
        "IK_MINING_TOOL": 1,
        "IK_BOW": 2,
        "IK_ARROW": 3,
        "IK_BLAST_GUN": 4,
        "IK_DYNAMITE_SATCHEL": 5,
        "IK_BORE_CANNON": 6,
        "IK_ACID_MORTAR": 7,
        "IK_CLUSTER_LAUNCHER": 8,
        "IK_MINIGUN": 9,
        "IK_RESCUE_BEAM": 10
      }
    },
    "ProjectileKind": {
