      [100, 35, 100, 35, 35, 35],
      [100, 35, 35, 100, 35, 35],
      [100, 25, 25, 60, 100, 35],
      [100, 100, 100, 100, 100, 100]
    ],
    "tierPercent": [50, 100, 135, 175, 210]
  },
